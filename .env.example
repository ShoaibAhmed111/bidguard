# ============================
# BidGuard AI - Environment Configuration
# Copy this file to .env and fill in real values.
# ============================

# Application environment: SANDBOX | PRODUCTION
APP_ENV=SANDBOX

# Sandbox gateway (mock GeM procurement endpoints)
SANDBOX_BASE_URL=http://localhost:8000/api/v1/mock

# API Setu (Government of India API platform) - production gateway
API_SETU_BASE_URL=https://apisetu.gov.in/api/v1
API_SETU_CLIENT_ID=
API_SETU_CLIENT_SECRET=

# Compliance thresholds
TURNOVER_TOLERANCE_PCT=0.10
MIN_NAME_MATCH_SIMILARITY=0.85

# Redis - cache / Celery task broker
REDIS_URL=redis://localhost:6379/0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Upload limits
MAX_UPLOAD_SIZE_MB=25
