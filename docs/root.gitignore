next-env.d.ts

# --- Environment & secrets ---
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# --- Uploads / generated artifacts ---
uploads/
tmp/
*.pdf.tmp

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
